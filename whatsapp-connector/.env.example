# The whatsapp-connector edge function of the VillaSafe project.
CONNECTOR_URL=https://mnrbxdpimeqtiwofjjri.supabase.co/functions/v1/whatsapp-connector

# Must match the WHATSAPP_CONNECTOR_SECRET project secret in Lovable.
# Make it long and random, e.g. the output of: openssl rand -hex 32
CONNECTOR_SECRET=

# Where the WhatsApp login is kept. Use persistent storage (a volume),
# or you'll have to scan the QR code again after every restart.
AUTH_DIR=./auth

# How the link appears on the phone under WhatsApp → Linked devices.
DEVICE_NAME=VillaSafe Inbox
